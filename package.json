{
  "name": "fontem-smoke-tests",
  "version": "1.0.0",
  "description": "Production smoke tests for GMR platform \u2014 runs every 8 hours",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:chromium": "npx playwright test --project=chromium",
    "lint": "eslint tests/ && node --test tests/prompt-lint.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "eslint": "^9.26.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "js-yaml@4": "4.3.1"
  }
}
